NEXT_PUBLIC_API_URL=http://localhost:5099

# --- Character Profile BFF (server-only; never prefix with NEXT_PUBLIC_) ---
# O24OpenAPI gateway used by GET /api/game/characters.
O24_API_BASE_URL=https://jitsapi.jits.com.vn:5555
O24_API_APP=BO
O24_API_LANG=vi
# Optional service credentials. WF_BO_GET_LIST_CHARACTER currently answers
# without them; set only a narrowly scoped service token, never a personal
# BO session token, and never commit real values.
O24_API_TOKEN=
O24_API_DEVICE_ID=
# Gateway timeout in ms (default 8000).
O24_API_TIMEOUT_MS=8000
